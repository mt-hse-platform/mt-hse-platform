# {$DOMAIN} comes from the environment (docker-compose.prod.yml). Caddy gets and renews the HTTPS certificate by itself;
# ports 80 and 443 must be reachable from the internet and the name must point to this server.
{$DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=(self)"
		# Report-only on purpose: it never blocks anything. Check the browser console after the first deployment, then
		# rename the header to Content-Security-Policy to enforce it.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; frame-src 'self' about:; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebaseinstallations.googleapis.com https://www.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# API: /api/x -> api:3000/x
	handle_path /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:3000
	}

	# The app (single-page): unknown paths fall back to index.html
	handle {
		root * /srv
		@shell path /sw.js /registerSW.js /manifest.webmanifest /index.html /
		header @shell Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

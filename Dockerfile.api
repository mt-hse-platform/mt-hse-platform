# API + PDF renderer image (arm64 and amd64). Build context: the repository root.
FROM node:22-bookworm-slim

ENV NODE_ENV=production
# Chromium renders the PDF reports; the Noto fonts provide Arabic glyphs (without them Arabic text becomes boxes).
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-noto-core fonts-dejavu-core ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# the root package.json ("type": "module") must be present: Node reads it to run the shared .ts files in /app/packages
COPY package.json ./
COPY apps/api/package.json apps/api/package.json
RUN npm install --omit=dev --prefix apps/api && npm cache clean --force

COPY packages packages
COPY scripts scripts
COPY apps/api/src apps/api/src

# uploaded files (photos, signatures, PDFs) live here; mounted as a named volume in production
RUN mkdir -p /data/media && chown -R node:node /data/media

USER node
ENV PORT=3000 MEDIA_DIR=/data/media CHROMIUM_PATH=/usr/bin/chromium PDF_NO_SANDBOX=1
EXPOSE 3000
CMD ["node", "--disable-warning=ExperimentalWarning", "apps/api/src/main.ts"]

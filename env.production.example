# Copy to .env.production and fill in. NEVER commit .env.production (it is in .gitignore).
# Generate strong passwords with:  openssl rand -base64 24 | tr -d '/+=' 

# Your public address WITHOUT https://  (for example: mt-hse.duckdns.org)
DOMAIN=mt-hse.duckdns.org

# Password of the database administrator ("postgres"). Only used by maintenance scripts.
POSTGRES_PASSWORD=change_me_long_random_1

# Password the application uses to connect (role app_user, which cannot bypass row-level security)
APP_DB_PASSWORD=change_me_long_random_2

# Firebase project used for sign-in
FIREBASE_PROJECT_ID=mt-hse-platform
